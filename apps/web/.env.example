# Public Firebase web configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Maps default to OpenStreetMap. No API key or billing account needed.
# Optional alternative tile provider; retain its required attribution.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Leave blank when using the local Vite proxy.
VITE_API_URL=
