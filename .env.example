# Copy to apps/api/.env. Local JSON persistence is used when DATABASE_URL is empty.
PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=
DIRECT_URL=
NODE_ENV=development
# Production: use custom sibling frontend/API domains for reliable cookies.
COOKIE_SAME_SITE=lax

# Server-only Firebase Admin configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file.
