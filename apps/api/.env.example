# Copy missing fields to apps/api/.env. Preserve your existing JWT_SECRET.
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Neon: pooled application URL and direct migration URL, both with sslmode=require.
DATABASE_URL=
DIRECT_URL=

# Firebase Admin: server-only service account credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS with an absolute service-account JSON path.

# data.gov.in account API key; never put this in the frontend.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# No Open-Meteo key is required for local noncommercial use.
