+export type ThreatKind = 'fungal' | 'bacterial' | 'viral' | 'insect';
+export type RiskLevel = 'Low' | 'Moderate' | 'High' | 'Very high';
+export type WeatherMode = 'wet' | 'dry' | 'neutral';
